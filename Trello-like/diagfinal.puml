' =======================================================
'                   HERITAGE (CORRIGÉ)
' =======================================================

' JavaFX Inheritances (Utilisation des vrais noms de classe)
javafx.scene.control.Label <|-- org.example.trellolike.vue.Etiquette.BadgeEtiquette
javafx.scene.control.ScrollPane <|-- org.example.trellolike.vue.VueGantt.VueGantt
javafx.scene.layout.VBox <|-- org.example.trellolike.vue.Kanban.ColonneKanban
javafx.scene.layout.HBox <|-- org.example.trellolike.vue.Liste_Archives.LigneTache
javafx.scene.layout.VBox <|-- org.example.trellolike.vue.Kanban.CarteTache
javafx.scene.control.ScrollPane <|-- org.example.trellolike.vue.Liste_Archives.VueArchives
javafx.scene.control.ScrollPane <|-- org.example.trellolike.vue.Kanban.VueTableau
javafx.scene.control.ScrollPane <|-- org.example.trellolike.vue.Liste_Archives.VueListe
javafx.application.Application <|-- org.example.trellolike.Trello_Like
javafx.scene.layout.BorderPane <|-- org.example.trellolike.vue.Calendrier.VueCalendrier

' Interfaces Java Standard
java.io.Serializable <|.. org.example.trellolike.tache.Tache
java.io.Serializable <|.. org.example.trellolike.tache.ListeDeTache
java.io.Serializable <|.. org.example.trellolike.Etiquette.Etiquette
java.io.Serializable <|.. org.example.trellolike.modele.Projet

' Implémentation du pattern Observer
org.example.trellolike.modele.Sujet <|.. org.example.trellolike.modele.Projet
org.example.trellolike.vue.Observateur <|.. org.example.trellolike.vue.VueGantt.VueGantt
org.example.trellolike.vue.Observateur <|.. org.example.trellolike.vue.Liste_Archives.VueArchives
org.example.trellolike.vue.Observateur <|.. org.example.trellolike.vue.Kanban.VueTableau
org.example.trellolike.vue.Observateur <|.. org.example.trellolike.vue.Liste_Archives.VueListe
org.example.trellolike.vue.Observateur <|.. org.example.trellolike.vue.Calendrier.VueCalendrier

' Héritage Métier
org.example.trellolike.tache.Tache <|-- org.example.trellolike.tache.TacheComposite
org.example.trellolike.tache.Tache <|-- org.example.trellolike.tache.TacheSimple


' =======================================================
'                   RELATIONS & ASSOCIATIONS
' =======================================================

' 1. STRUCTURE DU MODELE
' ----------------------
org.example.trellolike.modele.Projet "1" *-- "*" org.example.trellolike.tache.ListeDeTache : contient
org.example.trellolike.tache.ListeDeTache "1" o-- "*" org.example.trellolike.tache.Tache : contient
org.example.trellolike.tache.TacheComposite "1" o-- "*" org.example.trellolike.tache.Tache : sous-tâches
org.example.trellolike.tache.Tache "*" o-- "*" org.example.trellolike.Etiquette.Etiquette : possède

' 2. ARCHITECTURE MVC
' -------------------
' Contrôleurs -> Modèle
org.example.trellolike.controlleur.KanbanController --> org.example.trellolike.modele.Projet : manipule
org.example.trellolike.controlleur.ListeController --> org.example.trellolike.modele.Projet : manipule
org.example.trellolike.controlleur.GanttController --> org.example.trellolike.modele.Projet : lit
org.example.trellolike.controlleur.ArchiveController --> org.example.trellolike.modele.Projet : manipule
org.example.trellolike.controlleur.CalendarController --> org.example.trellolike.modele.Projet : lit

' Vues -> Contrôleurs
org.example.trellolike.vue.Kanban.VueTableau --> org.example.trellolike.controlleur.KanbanController : délègue
org.example.trellolike.vue.Liste_Archives.VueListe --> org.example.trellolike.controlleur.ListeController : délègue
org.example.trellolike.vue.VueGantt.VueGantt --> org.example.trellolike.controlleur.GanttController : délègue
org.example.trellolike.vue.Liste_Archives.VueArchives --> org.example.trellolike.controlleur.ArchiveController : délègue
org.example.trellolike.vue.Calendrier.VueCalendrier --> org.example.trellolike.controlleur.CalendarController : délègue

' 3. HIERARCHIE VISUELLE
' ----------------------
org.example.trellolike.vue.Kanban.VueTableau *-- "*" org.example.trellolike.vue.Kanban.ColonneKanban
org.example.trellolike.vue.Kanban.ColonneKanban *-- "*" org.example.trellolike.vue.Kanban.CarteTache
org.example.trellolike.vue.Liste_Archives.VueListe *-- "*" org.example.trellolike.vue.Liste_Archives.LigneTache

' Affichage
org.example.trellolike.vue.Kanban.ColonneKanban --> org.example.trellolike.tache.ListeDeTache : affiche
org.example.trellolike.vue.Kanban.CarteTache --> org.example.trellolike.tache.Tache : affiche
org.example.trellolike.vue.Liste_Archives.LigneTache --> org.example.trellolike.tache.Tache : affiche

' 4. COMPOSANTS GRAPHIQUES
' ------------------------
org.example.trellolike.vue.Kanban.CarteTache ..> org.example.trellolike.vue.Etiquette.BadgeEtiquette : utilise
org.example.trellolike.vue.Liste_Archives.LigneTache ..> org.example.trellolike.vue.Etiquette.BadgeEtiquette : utilise
org.example.trellolike.vue.Etiquette.BadgeEtiquette ..> org.example.trellolike.Etiquette.Etiquette : représente

' 5. SYSTEME
' ----------
org.example.trellolike.Trello_Like --> org.example.trellolike.modele.Projet : charge
org.example.trellolike.Trello_Like --> org.example.trellolike.controlleur.KanbanController : init
org.example.trellolike.modele.Projet ..> org.example.trellolike.tache.GestionPersistance : persiste

@enduml